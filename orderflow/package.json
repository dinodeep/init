{
  "name": "orderflow",
  "version": "1.0.0",
  "private": true,
  "description": "A small order-processing backend for an online store (interview exercise).",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:level1": "vitest run tests/part1/level1",
    "test:level2": "vitest run tests/part1/level2",
    "test:level3": "vitest run tests/part1/level3",
    "test:level4": "vitest run tests/part1/level4",
    "test:level5": "vitest run tests/part1/level5",
    "test:part1": "vitest run tests/part1",
    "test:part2": "vitest run tests/part2",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/demo.ts"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
